<?php
declare(strict_types=1);

/**
 * Couche Routeur – ARA Tech WiFi
 * -----------------------------------------------
 * Encapsule les appels génériques au système MikroTik
 * (interfaces, monitoring, identité, horloge…).
 */
class Router
{
    private RouterosAPI $api;
    private bool $connected;
    private array $config;

    public function __construct(array $mikrotikConfig)
    {
        $this->config = $mikrotikConfig;
        $this->api = new RouterosAPI();
        $this->api->timeout = $mikrotikConfig['connect_timeout'] ?? 2;
        $this->api->attempts = $mikrotikConfig['connect_retries'] ?? 1;

        $this->connected = $this->api->connect(
            $mikrotikConfig['host'],
            $mikrotikConfig['api_user'],
            $mikrotikConfig['api_password'],
            (int)($mikrotikConfig['api_port'] ?? 8728)
        );
    }

    public function isConnected(): bool
    {
        return $this->connected;
    }

    public function disconnect(): void
    {
        if ($this->connected) {
            $this->api->disconnect();
            $this->connected = false;
        }
    }

    // ---------------------------------------------------------------------
    // Informations système
    // ---------------------------------------------------------------------

    public function getIdentity(): string
    {
        $r = $this->api->comm('/system/identity/print');
        return $r[0]['name'] ?? 'MikroTik';
    }

    public function getClock(): array
    {
        $r = $this->api->comm('/system/clock/print');
        return $r[0] ?? [];
    }

    public function getResources(): array
    {
        $r = $this->api->comm('/system/resource/print');
        return $r[0] ?? [];
    }

    // ---------------------------------------------------------------------
    // Interfaces réseau
    // ---------------------------------------------------------------------

    /**
     * Retourne la liste de toutes les interfaces.
     */
    public function getInterfaces(): array
    {
        return $this->api->comm('/interface/print');
    }

    /**
     * Récupère le trafic instantané d'une interface (bits/s).
     * Retourne [ 'tx' => int, 'rx' => int ].
     */
    public function getInterfaceTraffic(string $interfaceName): array
    {
        $traffic = $this->api->comm('/interface/monitor-traffic', [
            'interface' => $interfaceName,
            'once'      => '',
        ]);

        if (empty($traffic[0])) {
            return ['tx' => 0, 'rx' => 0];
        }

        return [
            'tx' => (int)($traffic[0]['tx-bits-per-second'] ?? 0),
            'rx' => (int)($traffic[0]['rx-bits-per-second'] ?? 0),
        ];
    }

    // ---------------------------------------------------------------------
    // DHCP (Phase 2)
    // ---------------------------------------------------------------------

    public function getDhcpServers(): array
    {
        return $this->api->comm('/ip/dhcp-server/print');
    }

    public function getDhcpLeases(): array
    {
        return $this->api->comm('/ip/dhcp-server/lease/print');
    }

    // ---------------------------------------------------------------------
    // IP / ARP
    // ---------------------------------------------------------------------

    public function getArpTable(): array
    {
        return $this->api->comm('/ip/arp/print');
    }

    /**
     * Ajoute une liaison IP → MAC statique.
     */
    public function addStaticArp(string $ip, string $mac): void
    {
        $this->api->comm('/ip/arp/add', [
            'address' => $ip,
            'mac-address' => $mac,
        ]);
    }

    /**
     * Supprime une entrée ARP.
     */
    public function removeArp(string $id): void
    {
        $this->api->comm('/ip/arp/remove', ['.id' => $id]);
    }
}
