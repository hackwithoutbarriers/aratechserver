# =============================================================================
# ARA Tech WiFi - HotSpot on-login sale handler
# -----------------------------------------------------------------------------
# IMPORTANT:
#   - A login/re-login is NOT automatically a sale.
#   - A sale is emitted only on a NEW activation marker (vc/up/empty comment).
#   - Reconnecting an existing voucher only refreshes expiry synchronization.
#   - Mikhmon history entry and record-sale are also created only for a sale.
#
# PRICE MAP (verify before production):
#   10H        = 100 XOF
#   24H        = 200 XOF
#   Abonnement = 1000 XOF (observed in current sales_log export; change if your
#                current business price differs)
#   test/demo  = 0 XOF and NOT a business sale
#
# The production on-login field should contain the logic below. Keep the same
# RouterOS variables available in your existing field: $user, $address and
# $"mac-address".
# =============================================================================

:local userComment [/ip hotspot user get [/ip hotspot user find where name="$user"] comment]
:local userProfile [/ip hotspot user get [/ip hotspot user find where name="$user"] profile]
:local ucode [:pick $userComment 0 2]
:local isNewSale false

# A fresh voucher generated by the selling flow is identified by the marker
# already used by the existing configuration, or by an empty comment.
:if ($ucode = "vc" or $ucode = "up" or $userComment = "") do={
    :set isNewSale true

    :local date [/system clock get date]
    :local time [/system clock get time]

    /system scheduler add name=$user disable=no start-date=$date interval="24h"
    :delay 2s
    :local schedulerId [/system scheduler find where name="$user"]
    :local exp ""
    :if ([:len $schedulerId] > 0) do={
        :set exp [:tostr [/system scheduler get $schedulerId next-run]]
        /system scheduler remove $schedulerId
    }

    :if ($exp != "") do={
        /ip hotspot user set comment=$exp [find where name="$user"]
        :set userComment $exp
    }
}

# Expiry synchronization is allowed on every login/re-login.
:if ($userComment != "") do={
    :do {
        /tool fetch mode=https http-method=post duration=6s \
            http-header-field="Content-Type:application/json,X-API-Key:REPLACE_WITH_ROTATED_HOTSPOT_SYNC_KEY" \
            http-data=("{\"user\":\"" . $user . "\",\"expiry\":\"" . $userComment . "\"}") \
            url="https://aratech-ldg0.onrender.com/api.php?route=set-expiry" \
            check-certificate=yes output=none
    } on-error={
        :log warning ("ARA Tech: sync expiry echoue pour " . $user)
    }
}

# Commercial event: ONLY once per new activation.
:if ($isNewSale = true) do={
    :local saleDate [/system clock get date]
    :local saleTime [/system clock get time]
    :local saleMac $"mac-address"
    :local saleAmount 0
    :local isBusinessSale true

    :if ($userProfile = "10H") do={ :set saleAmount 100 }
    :if ($userProfile = "24H") do={ :set saleAmount 200 }
    :if ($userProfile = "Abonnement") do={ :set saleAmount 1000 }
    :if ($userProfile = "test" or $userProfile = "testing" or $userProfile = "demo") do={
        :set saleAmount 0
        :set isBusinessSale false
    }

    :if ($saleAmount > 0) do={
        # Stable idempotency key. A second purchase with the same voucher at a
        # different time gets another transaction id; an HTTP retry of this
        # exact event gets the same id and is safely ignored by the server.
        :local transactionId ($saleDate . "|" . $saleTime . "|" . $user . "|" . $saleAmount . "|" . $address . "|" . $saleMac . "|" . $userProfile . "|" . $userComment)
        :local saleJson ("{\"transaction_id\":\"" . $transactionId . "\",\"date\":\"" . $saleDate . "\",\"time\":\"" . $saleTime . "\",\"user\":\"" . $user . "\",\"amount\":" . $saleAmount . ",\"ip\":\"" . $address . "\",\"mac\":\"" . $saleMac . "\",\"profile\":\"" . $userProfile . "\",\"comment\":\"" . $userComment . "\",\"is_business_sale\":" . [:tostr $isBusinessSale] . "}")

        :do {
            /tool fetch mode=https duration=6s http-method=post \
                url="https://aratech-ldg0.onrender.com/record-sale.php" \
                http-header-field="Content-Type:application/json,X-API-Key:REPLACE_WITH_ROTATED_HOTSPOT_SYNC_KEY" \
                http-data=$saleJson check-certificate=yes output=none
        } on-error={
            :log warning ("ARA Tech: enregistrement vente echoue pour " . $user)
        }

        # Preserve the Mikhmon history mechanism, but only for real sales.
        :local scriptName ($saleDate . "-| -" . $saleTime . "-| -" . $user . "-| -" . $saleAmount . "-| -" . $address . "-| -" . $saleMac . "-| -" . $userProfile . "-| -" . $userComment)
        /system script add name=$scriptName owner="mikhmon" source=$saleDate comment="mikhmon"
    }
}
